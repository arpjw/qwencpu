+"""Small tensor/config checks for untied Qwen3.5 output-head merging."""
+
+from __future__ import annotations
+
+import unittest
+
+import torch
+
+from chipformer.rv.merge import merged_output_head
+from chipformer.rv.merge_config import merged_text_config, output_head_is_tied
+
+
+class NineBMergeTests(unittest.TestCase):
+    def test_9b_outer_config_controls_untied_head(self) -> None:
+        cfg = {"tie_word_embeddings": False,
+               "text_config": {"tie_word_embeddings": True}}
+        self.assertFalse(output_head_is_tied(cfg))
+        self.assertTrue(output_head_is_tied({"tie_word_embeddings": True,
+                                             "text_config": {}}))
+
+    def test_untied_head_preserves_base_logits_and_circuit_rows(self) -> None:
+        base = torch.tensor([[1., 2., 3.], [4., 5., 6.]], dtype=torch.bfloat16)
+        emb = torch.tensor([[10., 11., 12., 1., 0.],
+                            [13., 14., 15., 0., 1.],
+                            [0., 0., 0., 1., 1.]], dtype=torch.bfloat16)
+        original = emb.clone()
+        head = merged_output_head(base, emb, 3, 2, tied=False)
+        assert head is not None
+        torch.testing.assert_close(head[:2, :3], base)
+        torch.testing.assert_close(head[:, 3:], emb[:, 3:])
+        torch.testing.assert_close(emb, original)
+        hidden = torch.tensor([2., -1., 3., 0., 0.], dtype=torch.bfloat16)
+        torch.testing.assert_close(head[:2] @ hidden, base @ hidden[:3])
+        chip_hidden = torch.tensor([0., 0., 0., 2., 3.], dtype=torch.bfloat16)
+        torch.testing.assert_close(head @ chip_hidden, emb @ chip_hidden)
+
+    def test_missing_or_misshapen_untied_head_fails_closed(self) -> None:
+        emb = torch.zeros(3, 5, dtype=torch.bfloat16)
+        for head in (None, torch.zeros(2, 4)):
+            with self.subTest(head=head):
+                with self.assertRaisesRegex(ValueError, "requires lm_head.weight shaped"):
+                    merged_output_head(head, emb, 3, 2, tied=False)
+        self.assertIsNone(merged_output_head(None, emb, 3, 2, tied=True))
+
+    def test_text_config_keeps_9b_untied_and_adds_chip_layers(self) -> None:
+        base = {"hidden_size": 4096, "num_hidden_layers": 32,
+                "vocab_size": 248320, "mtp_num_hidden_layers": 1,
+                "full_attention_interval": 4,
+                "layer_types": ["linear_attention"] * 24 + ["full_attention"] * 8}
+        merged = merged_text_config(base, hidden=7168, n_chip=11,
+                                    chip_vocab=230324, tied=False)
+        self.assertFalse(merged["tie_word_embeddings"])
+        self.assertEqual(merged["num_hidden_layers"], 43)
+        self.assertEqual(merged["layer_types"][:11], ["linear_attention"] * 11)
+        self.assertEqual(merged["layer_types"][11:], base["layer_types"])
+        self.assertEqual(merged["vocab_size"] % 64, 0)
+        self.assertNotIn("full_attention_interval", merged)
+        self.assertEqual(base["hidden_size"], 4096)
+
+
+if __name__ == "__main__":
+    unittest.main()

+"""Check the published 9B config without importing model or tensor packages."""
+
+from __future__ import annotations
+
+import json
+import unittest
+from pathlib import Path
+
+from chipformer.rv.merge_config import merged_text_config, output_head_is_tied
+
+
+class NineBConfigTests(unittest.TestCase):
+    def test_published_config_is_untied_and_has_required_heads(self) -> None:
+        fixture = Path(__file__).parent / "fixtures" / "qwen35_9b_config.json"
+        cfg = json.loads(fixture.read_text())
+        text = cfg["text_config"]
+        self.assertFalse(output_head_is_tied(cfg))
+        self.assertEqual(text["hidden_size"], 4096)
+        self.assertEqual(text["vocab_size"], 248320)
+        self.assertEqual((text["linear_num_key_heads"], text["linear_num_value_heads"]),
+                         (16, 32))
+        merged = merged_text_config(text, hidden=7168, n_chip=11,
+                                    chip_vocab=230324, tied=output_head_is_tied(cfg))
+        self.assertFalse(merged["tie_word_embeddings"])
+        self.assertEqual(merged["num_hidden_layers"], 43)
+        self.assertEqual(merged["vocab_size"], 478656)
+        self.assertEqual(merged["layer_types"][11:], text["layer_types"])
+
+
+if __name__ == "__main__":
+    unittest.main()
